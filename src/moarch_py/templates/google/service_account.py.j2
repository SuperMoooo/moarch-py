"""A Google service account: access tokens for Google's APIs (FCM, Play Integrity, Play billing).

One JWT signed with the account's key, traded at Google's token endpoint for
an access token that lasts an hour (the OAuth JWT-bearer grant, RFC 7523).
Made here with PyJWT, so no Google SDK is needed.
"""

import json
import time
from pathlib import Path
from typing import Self

import httpx
import jwt

# A token is asked for again this long before it expires, so no call ever
# goes out with one that expires on the way.
_REFRESH_MARGIN_SECONDS = 300


class GoogleServiceAccount:
    """Calls Google's APIs as one service account, caching a token per scope."""

    def __init__(self, key: dict[str, str], http: httpx.AsyncClient | None = None) -> None:
        self.key = key
        self.http = http or httpx.AsyncClient(timeout=10)
        self._tokens: dict[str, tuple[str, float]] = {}

    @classmethod
    def from_file(cls, path: str) -> Self:
        """The account whose JSON key file is at [path] (Cloud console: IAM, Service accounts)."""
        key: dict[str, str] = json.loads(Path(path).read_text(encoding="utf-8"))
        return cls(key)

    @property
    def project_id(self) -> str:
        """The Google Cloud (and Firebase) project the account belongs to."""
        return self.key["project_id"]

    async def headers(self, scope: str) -> dict[str, str]:
        """The Authorization header for a call that needs [scope]."""
        return {"Authorization": f"Bearer {await self.access_token(scope)}"}

    async def access_token(self, scope: str) -> str:
        """An access token for [scope], from the cache while it is still good."""
        cached = self._tokens.get(scope)
        if cached is not None and time.time() < cached[1] - _REFRESH_MARGIN_SECONDS:
            return cached[0]
        now = int(time.time())
        token_uri = self.key["token_uri"]
        assertion = jwt.encode(
            {
                "iss": self.key["client_email"],
                "scope": scope,
                "aud": token_uri,
                "iat": now,
                "exp": now + 3600,
            },
            self.key["private_key"],
            algorithm="RS256",
        )
        response = await self.http.post(
            token_uri,
            data={"grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer", "assertion": assertion},
        )
        response.raise_for_status()
        body = response.json()
        token = str(body["access_token"])
        self._tokens[scope] = (token, now + float(body["expires_in"]))
        return token

"""The Google service account's token exchange, against a mocked Google."""

import httpx
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa

from {{ name.package }}.core.google_service_account import GoogleServiceAccount

_KEY = rsa.generate_private_key(public_exponent=65537, key_size=2048)
SERVICE_ACCOUNT = {
    "project_id": "demo-project",
    "client_email": "api@demo-project.iam.gserviceaccount.com",
    "token_uri": "https://oauth2.googleapis.com/token",
    "private_key": _KEY.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    ).decode(),
}


def mocked_google(answer_api: httpx.Response, seen: list[httpx.Request]) -> httpx.AsyncClient:
    """Google's token endpoint, then [answer_api] for every other call."""

    def answer(request: httpx.Request) -> httpx.Response:
        seen.append(request)
        if request.url.host == "oauth2.googleapis.com":
            return httpx.Response(200, json={"access_token": "google-access", "expires_in": 3600})
        return answer_api

    return httpx.AsyncClient(transport=httpx.MockTransport(answer))


async def test_a_token_is_asked_for_once_per_scope() -> None:
    seen: list[httpx.Request] = []
    account = GoogleServiceAccount(SERVICE_ACCOUNT, mocked_google(httpx.Response(200), seen))

    first = await account.headers("scope-a")
    again = await account.headers("scope-a")

    assert first == again == {"Authorization": "Bearer google-access"}
    assert len(seen) == 1
    assert b"jwt-bearer" in seen[0].content

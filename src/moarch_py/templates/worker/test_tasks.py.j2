"""Tasks, run by the in-memory broker the tests use, and the request ID they carry."""

import contextvars

from taskiq import TaskiqMessage

from {{ name.package }}.core.request_id import current_request_id, request_id_scope
from {{ name.package }}.worker.broker import CarryRequestId
from {{ name.package }}.worker.tasks import log_message


async def test_a_task_runs_when_it_is_sent() -> None:
    task = await log_message.kiq("hello")

    result = await task.wait_result(timeout=5)

    assert not result.is_err


def _message() -> TaskiqMessage:
    return TaskiqMessage(task_id="1", task_name="log_message", labels={}, args=[], kwargs={})


def test_a_task_is_sent_with_the_id_of_its_request() -> None:
    with request_id_scope("req-from-the-api"):
        message = CarryRequestId().pre_send(_message())

    assert message.labels["request_id"] == "req-from-the-api"


def test_a_task_runs_with_the_id_it_was_sent_with() -> None:
    message = _message()
    message.labels["request_id"] = "req-from-the-api"

    # In a copy of the context, as the worker runs each task in its own: the
    # ID must not stay set for the tests that follow.
    seen = contextvars.copy_context().run(_request_id_while_running, message)

    assert seen == "req-from-the-api"


def test_a_scheduled_task_gets_an_id_of_its_own() -> None:
    seen = contextvars.copy_context().run(_request_id_while_running, _message())

    assert seen is not None


def _request_id_while_running(message: TaskiqMessage) -> str | None:
    CarryRequestId().pre_execute(message)
    return current_request_id()

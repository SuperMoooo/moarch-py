# Local stack: `docker compose up --build`, then http://localhost:8000/docs

# What every process built from this image shares (the API, and a worker or
# scheduler when the project has them): one place to add a setting.
x-app: &app
  build: .
  env_file:
    - path: .env
      required: false
  # A dependency (the broker, Redis) may still be starting; try again rather than stay down.
  restart: on-failure
  environment:
    # One JSON object per line, as a log collector reads them.
    LOG_FORMAT: json
{% if database.runs_in_container %}
    DATABASE_URL: {{ database.compose_url(name.package) }}
{% else %}
    # SQLite lives in a volume, so the data survives `docker compose down`.
    DATABASE_URL: sqlite+aiosqlite:////data/{{ name.package }}.db
{% endif %}
    # moarch:compose-environment
{% if not database.runs_in_container %}
  volumes:
    - sqlite-data:/data
{% endif %}

services:
  api:
    <<: *app
    ports:
      - "8000:8000"
{% if options.migrations %}
    # Migrate first, then serve: the app never starts against an old schema.
    command: sh -c "alembic upgrade head && uvicorn {{ name.package }}.main:app --host 0.0.0.0 --port 8000"
{% endif %}
{% if database.runs_in_container %}
    depends_on:
      db:
        condition: service_healthy

  db:
{% if database.value == "postgres" %}
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ name.package }}
    ports:
      - "5432:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ name.package }}"]
      interval: 5s
      timeout: 5s
      retries: 10
{% else %}
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: {{ name.package }}
      MYSQL_USER: app
      MYSQL_PASSWORD: app
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uapp", "-papp"]
      interval: 5s
      timeout: 5s
      retries: 20
{% endif %}
{% endif %}

  # moarch:compose-services

volumes:
{% if database.runs_in_container %}
  db-data:
{% else %}
  sqlite-data:
{% endif %}

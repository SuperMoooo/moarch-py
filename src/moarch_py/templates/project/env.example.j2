# Copy to .env and fill in. Every key here is a field on Settings
# (src/{{ name.package }}/core/config.py); real environment variables win over .env.

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL={{ database.local_url(name.package) }}
DATABASE_ECHO=false

# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=[]

# true: every module answers from its mocks.py samples, not the database, so a
# client can be tested before real data exists. Refused in production.
MOCK_RESPONSES=false

"""The FastAPI application: settings, database, middleware and routers, wired once."""

import logging
from collections.abc import AsyncIterator, Awaitable, Callable
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request, Response
from fastapi.middleware.cors import CORSMiddleware

from {{ name.package }}.api.health import router as health_router
from {{ name.package }}.api.v1.router import api_router as api_v1_router
from {{ name.package }}.core.config import Settings, get_settings
from {{ name.package }}.core.errors import register_error_handlers
from {{ name.package }}.core.logging import configure_logging
from {{ name.package }}.core.request_id import REQUEST_ID_HEADER, RequestIdMiddleware
from {{ name.package }}.db.session import create_engine, create_session_factory

# moarch:main-imports

logger = logging.getLogger(__name__)


def create_app(settings: Settings | None = None) -> FastAPI:
    """Builds the app. Tests pass their own [settings] (an in-memory database)."""
    settings = settings or get_settings()
    configure_logging(settings)
    # moarch:setup
    engine = create_engine(settings)

    @asynccontextmanager
    async def lifespan(running_app: FastAPI) -> AsyncIterator[None]:
        # moarch:startup
        yield
        # Close pooled connections on shutdown so the database is not left
        # holding them until they time out.
        await engine.dispose()
        # moarch:shutdown

    app = FastAPI(
        title=settings.app_name,
        debug=settings.debug,
        lifespan=lifespan,
        # No interactive docs in production: they list every endpoint.
        docs_url=None if settings.is_production else "/docs",
        redoc_url=None,
    )
    # The engine is built here, not in the lifespan, so tests that skip the
    # lifespan (httpx's ASGITransport) still get a working database.
    app.state.settings = settings
    app.state.engine = engine
    app.state.session_factory = create_session_factory(engine)
    # moarch:app-state

    # Starlette runs the middleware added last first: these sit inside CORS,
    # so even a response they refuse with (a 429) carries the CORS headers.
    # moarch:middleware
    if settings.cors_origins:
        app.add_middleware(
            CORSMiddleware,
            allow_origins=settings.cors_origins,
            allow_credentials=True,
            allow_methods=["*"],
            allow_headers=["*"],
            # Lets browser code read the ID, to show it in an error or a bug report.
            expose_headers=[REQUEST_ID_HEADER],
        )
    if settings.mock_responses:
        mark_responses_as_mocked(app)
    # Last, so it runs first: every other middleware's log lines carry the request ID.
    app.add_middleware(RequestIdMiddleware)
    register_error_handlers(app)
    app.include_router(health_router)
    app.include_router(api_v1_router, prefix=settings.api_v1_prefix)
    # moarch:app-routers
    return app


def mark_responses_as_mocked(app: FastAPI) -> None:
    """Adds `X-Mock-Response: true` to every response, so no one takes sample data for real."""
    logger.warning("MOCK_RESPONSES is on: modules answer from their samples, not the database.")

    @app.middleware("http")
    async def add_mock_header(
        request: Request, call_next: Callable[[Request], Awaitable[Response]]
    ) -> Response:
        response = await call_next(request)
        response.headers["X-Mock-Response"] = "true"
        return response


app = create_app()

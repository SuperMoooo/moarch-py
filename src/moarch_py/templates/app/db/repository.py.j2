"""The database calls every repository shares. Repositories are the only layer that queries."""

from collections.abc import Sequence

from sqlalchemy import func, inspect, select
from sqlalchemy.ext.asyncio import AsyncSession

from {{ name.package }}.db.base import Base


class BaseRepository[ModelT: Base]:
    """Reads and writes one model's table. A module's repository subclasses it.

    Writes `flush` (send the SQL, get generated ids) but never `commit`: the
    service decides when a unit of work is complete.
    """

    model: type[ModelT]

    def __init__(self, session: AsyncSession) -> None:
        self.session = session

    async def get_by_id(self, entity_id: int) -> ModelT | None:
        """The row with this primary key, or None."""
        return await self.session.get(self.model, entity_id)

    async def list_page(self, *, offset: int = 0, limit: int = 50) -> Sequence[ModelT]:
        """One page of rows, oldest first, so pages stay stable while rows are added."""
        primary_key = inspect(self.model).primary_key
        query = select(self.model).order_by(*primary_key).offset(offset).limit(limit)
        return (await self.session.scalars(query)).all()

    async def count(self) -> int:
        """How many rows the table has, for a paginated response's total."""
        query = select(func.count()).select_from(self.model)
        return (await self.session.scalar(query)) or 0

    async def add(self, entity: ModelT) -> ModelT:
        """Inserts [entity] and loads what the database generated (id, timestamps)."""
        self.session.add(entity)
        await self.session.flush()
        await self.session.refresh(entity)
        return entity

    async def save(self, entity: ModelT) -> ModelT:
        """Sends pending changes to [entity] and reloads it (for `updated_at`)."""
        await self.session.flush()
        await self.session.refresh(entity)
        return entity

    async def delete(self, entity: ModelT) -> None:
        """Deletes [entity]'s row."""
        await self.session.delete(entity)
        await self.session.flush()

"""Liveness and readiness probes, outside the versioned API so their URLs never move."""

from fastapi import APIRouter, Response, status
from sqlalchemy import text

from {{ name.package }}.db.session import SessionDep

router = APIRouter(prefix="/health", tags=["Health"])


@router.get("")
async def check_liveness() -> dict[str, str]:
    """The process is up. Never touches the database, so a slow DB cannot restart the app."""
    return {"status": "ok"}


@router.get("/ready")
async def check_readiness(session: SessionDep, response: Response) -> dict[str, str]:
    """The app can reach its database; a load balancer sends traffic only when this is 200."""
    try:
        await session.execute(text("SELECT 1"))
    except Exception:
        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE
        return {"status": "unavailable", "database": "unreachable"}
    return {"status": "ok", "database": "ok"}

# Runs on every `git commit` once installed: `uv run pre-commit install`.
# The hooks call the project's own ruff through uv, so their version is the
# one in uv.lock — the same as CI — rather than a second pin here.
repos:
  - repo: local
    hooks:
      - id: ruff-format
        name: ruff format
        entry: uv run ruff format
        language: system
        types: [python]
      - id: ruff-check
        name: ruff check
        entry: uv run ruff check --fix
        language: system
        types: [python]
      - id: lint-imports
        name: module boundaries (import-linter)
        entry: uv run lint-imports
        language: system
        types: [python]
        # It reads the whole import graph, not the changed files one by one.
        pass_filenames: false
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: check-yaml
      - id: end-of-file-fixer
      - id: trailing-whitespace
      - id: check-added-large-files
      - id: detect-private-key

"""Refresh tokens: single-use, traded on every refresh, revoked as a family on reuse."""

import hashlib
import secrets
import uuid
from datetime import UTC, datetime, timedelta

from fastapi import status
from sqlalchemy.ext.asyncio import AsyncSession

from {{ name.package }}.core.config import Settings
from {{ name.package }}.core.errors import AppError
from {{ name.package }}.db.base import as_utc
from {{ name.package }}.modules.users.models import RefreshToken
from {{ name.package }}.modules.users.parts import AuthEvent, AuthParts
from {{ name.package }}.modules.users.repository import RefreshTokenRepository
from {{ name.package }}.modules.users.schemas import TokenPair
from {{ name.package }}.modules.users.tokens import create_access_token


class RefreshTokenRejectedError(AppError):
    """The refresh token is unknown, expired or revoked: the app must sign in again."""

    status_code = status.HTTP_401_UNAUTHORIZED
    code = "refresh_token_rejected"

    def __init__(self) -> None:
        super().__init__("This session has ended. Sign in again.")


class RefreshTokenReusedError(RefreshTokenRejectedError):
    """A refresh token came back after it was already traded: a copy of it exists."""

    def __init__(self, user_id: int) -> None:
        super().__init__()
        self.user_id = user_id


def hash_token(token: str) -> str:
    """What is stored for [token]: its SHA-256. No salt needed, the token is 256 random bits."""
    return hashlib.sha256(token.encode()).hexdigest()


class RefreshTokens:
    """Issues, rotates and revokes refresh tokens (`AuthParts.refresh_tokens`). Never commits."""

    def __init__(self, repository: RefreshTokenRepository, settings: Settings) -> None:
        self.repository = repository
        self.settings = settings

    async def issue(self, user_id: int, family_id: str | None = None) -> str:
        """A new token: the first of a new sign-in, or the next one of [family_id]."""
        token = secrets.token_urlsafe(32)
        await self.repository.add(
            RefreshToken(
                user_id=user_id,
                family_id=family_id or str(uuid.uuid4()),
                token_hash=hash_token(token),
                expires_at=datetime.now(UTC) + timedelta(days=self.settings.refresh_token_days),
            )
        )
        return token

    async def rotate(self, token: str) -> tuple[int, str]:
        """Trades [token] for the next one of its family: (user id, new token).

        A token already traded means someone holds a copy. Which one is the
        thief cannot be known, so the whole family is revoked and both sign in
        again (RefreshTokenReusedError).
        """
        stored = await self.repository.find_by_hash(hash_token(token))
        now = datetime.now(UTC)
        if stored is None or stored.revoked_at is not None or as_utc(stored.expires_at) <= now:
            raise RefreshTokenRejectedError
        if stored.used_at is not None:
            await self.repository.revoke_family(stored.family_id, now)
            raise RefreshTokenReusedError(stored.user_id)
        stored.used_at = now
        await self.repository.save(stored)
        return stored.user_id, await self.issue(stored.user_id, stored.family_id)

    async def revoke_family_of(self, token: str) -> None:
        """Ends the sign-in [token] belongs to; an unknown token is ignored."""
        stored = await self.repository.find_by_hash(hash_token(token))
        if stored is not None:
            await self.repository.revoke_family(stored.family_id, datetime.now(UTC))

    async def revoke_all_for(self, user_id: int) -> None:
        """Ends every sign-in of the user."""
        await self.repository.revoke_all_for_user(user_id, datetime.now(UTC))


class RefreshService:
    """`POST /auth/refresh`: a refresh token for a new token pair."""

    def __init__(
        self,
        session: AsyncSession,
        refresh_tokens: RefreshTokens,
        parts: AuthParts,
        settings: Settings,
    ) -> None:
        self.session = session
        self.refresh_tokens = refresh_tokens
        self.parts = parts
        self.settings = settings

    async def refresh(self, token: str) -> TokenPair:
        """A new access token and the next refresh token; commits."""
        try:
            user_id, refresh_token = await self.refresh_tokens.rotate(token)
        except RefreshTokenReusedError as reuse:
            await self.parts.record(AuthEvent.REFRESH_TOKEN_REUSED, reuse.user_id)
            # Committed before failing, or the revoked family would come back.
            await self.session.commit()
            raise
        await self.session.commit()
        return TokenPair(
            access_token=create_access_token(user_id, self.settings), refresh_token=refresh_token
        )


async def purge_expired_refresh_tokens(session: AsyncSession) -> None:
    """Deletes refresh tokens past their expiry, which no one can use any more; commits."""
    await RefreshTokenRepository(session).delete_expired(datetime.now(UTC))
    await session.commit()

"""The password policy and hashing."""

import pytest

from {{ name.package }}.core.config import Settings
from {{ name.package }}.modules.users.passwords import (
    WeakPasswordError,
    check_password_policy,
    hash_password,
    verify_password,
)


def test_the_default_policy_asks_only_for_length() -> None:
    check_password_policy("eight ch", Settings())

    with pytest.raises(WeakPasswordError, match="at least 8 characters"):
        check_password_policy("seven c", Settings())


def test_every_broken_rule_is_named_at_once() -> None:
    settings = Settings(password_require_number=True, password_require_symbol=True)

    with pytest.raises(WeakPasswordError) as raised:
        check_password_policy("lettersonly", settings)

    assert "a number" in raised.value.message
    assert "a symbol" in raised.value.message


async def test_a_hash_verifies_its_password_only() -> None:
    hashed = await hash_password("the right one")

    assert await verify_password("the right one", hashed)
    assert not await verify_password("the wrong one", hashed)


async def test_no_hash_never_verifies() -> None:
    assert not await verify_password("anything", None)

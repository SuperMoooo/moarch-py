"""Password hashing (argon2id) and the project's password policy."""

import asyncio
from functools import cache

from pwdlib import PasswordHash

from {{ name.package }}.core.config import Settings
from {{ name.package }}.core.errors import AppError

# argon2id at pwdlib's recommended cost.
_hasher = PasswordHash.recommended()


class WeakPasswordError(AppError):
    """The new password breaks the project's password policy."""

    status_code = 422
    code = "weak_password"


def check_password_policy(password: str, settings: Settings) -> None:
    """Raises WeakPasswordError naming every rule [password] breaks, so it is fixed in one go.

    The rules are settings. Their defaults follow NIST SP 800-63B: length
    matters; forced mixes of characters do not (they push people to
    predictable "Passw0rd!"), so they are off unless the project turns them on.
    """
    problems: list[str] = []
    if len(password) < settings.password_min_length:
        problems.append(f"at least {settings.password_min_length} characters")
    if len(password) > settings.password_max_length:
        problems.append(f"at most {settings.password_max_length} characters")
    if settings.password_require_uppercase and not any(c.isupper() for c in password):
        problems.append("a capital letter")
    if settings.password_require_lowercase and not any(c.islower() for c in password):
        problems.append("a lower-case letter")
    if settings.password_require_number and not any(c.isdigit() for c in password):
        problems.append("a number")
    if settings.password_require_symbol and all(c.isalnum() or c.isspace() for c in password):
        problems.append("a symbol")
    if problems:
        raise WeakPasswordError(f"The password needs {', '.join(problems)}.")


async def hash_password(password: str) -> str:
    """The argon2id hash to store.

    In a thread: hashing is deliberately slow CPU work (tens of milliseconds),
    which would otherwise stall every other request on the event loop.
    """
    return await asyncio.to_thread(_hasher.hash, password)


@cache
def _hash_of_nothing() -> str:
    return _hasher.hash("no account has this password")


async def verify_password(password: str, password_hash: str | None) -> bool:
    """True when [password] matches [password_hash].

    With no hash (an unknown email, or a Google/Apple-only account) it still
    checks against a real hash before answering False, so "no such user" takes
    as long as "wrong password" and the timing does not reveal which emails
    have accounts.
    """
    if password_hash is None:
        await asyncio.to_thread(_hasher.verify, password, _hash_of_nothing())
        return False
    return await asyncio.to_thread(_hasher.verify, password, password_hash)

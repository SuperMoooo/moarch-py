"""Writes auth events into the audit log, for a project with both auth and the audit log."""

from sqlalchemy.ext.asyncio import AsyncSession

from {{ name.package }}.modules.audit.public import record_audit_event
from {{ name.package }}.modules.users.parts import AuthEvent


class AuditLogRecorder:
    """An `AuthEventRecorder` that keeps every auth event as an audit entry."""

    def __init__(self, session: AsyncSession) -> None:
        self.session = session

    async def record(self, event: AuthEvent, user_id: int | None, details: dict[str, str]) -> None:
        """Adds `auth.<event>` to the audit log; committed with the service's unit of work."""
        await record_audit_event(
            self.session,
            action=f"auth.{event.value}",
            actor_id=user_id,
            target_type="user" if user_id is not None else None,
            target_id=str(user_id) if user_id is not None else None,
            details=details,
        )

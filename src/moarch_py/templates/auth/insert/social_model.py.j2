class LinkedIdentity(TimestampMixin, Base):
    """A Google or Apple account attached to a user, known by that provider's own ID for it.

    The provider's ID (`subject`), not the email, is what identifies it: Apple
    sends the email only the first time, and a Google address can change.
    """

    __tablename__ = "linked_identities"
    __table_args__ = (UniqueConstraint("provider", "subject"),)

    id: Mapped[int] = mapped_column(primary_key=True)
    user_id: Mapped[int] = mapped_column(ForeignKey("users.id", ondelete="CASCADE"), index=True)
    provider: Mapped[str] = mapped_column(String(20))
    subject: Mapped[str] = mapped_column(String(255))

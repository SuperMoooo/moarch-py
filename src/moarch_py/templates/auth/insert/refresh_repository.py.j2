class RefreshTokenRepository(BaseRepository[RefreshToken]):
    """Reads and writes the refresh_tokens table."""

    model = RefreshToken

    async def find_by_hash(self, token_hash: str) -> RefreshToken | None:
        """The token with this hash, used or not."""
        query = select(RefreshToken).where(RefreshToken.token_hash == token_hash)
        return await self.session.scalar(query)

    async def revoke_family(self, family_id: str, at: datetime) -> None:
        """Revokes every token of one sign-in."""
        await self.session.execute(
            update(RefreshToken)
            .where(RefreshToken.family_id == family_id, RefreshToken.revoked_at.is_(None))
            .values(revoked_at=at)
        )

    async def revoke_all_for_user(self, user_id: int, at: datetime) -> None:
        """Revokes every token of every sign-in of the user."""
        await self.session.execute(
            update(RefreshToken)
            .where(RefreshToken.user_id == user_id, RefreshToken.revoked_at.is_(None))
            .values(revoked_at=at)
        )

    async def delete_expired(self, before: datetime) -> None:
        """Deletes tokens that expired before [before]; they can never be used again."""
        await self.session.execute(delete(RefreshToken).where(RefreshToken.expires_at < before))

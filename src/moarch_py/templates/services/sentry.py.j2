"""Error reporting with Sentry: every unhandled exception, with its request."""

import sentry_sdk

from {{ name.package }}.core.config import Settings


def configure_sentry(settings: Settings) -> None:
    """Starts Sentry when `SENTRY_DSN` is set; its FastAPI integration turns on by itself."""
    if not settings.sentry_dsn:
        return
    sentry_sdk.init(
        dsn=settings.sentry_dsn,
        environment=settings.environment.value,
        traces_sample_rate=settings.sentry_traces_sample_rate,
        # No user details (email, IP) in reports unless you decide otherwise.
        # sentry-sdk 3 names this data_collection (2.x: send_default_pii).
        data_collection={"user_info": False},
    )

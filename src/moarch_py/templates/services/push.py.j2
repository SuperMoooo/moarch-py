"""Push notifications to a user's devices, through Firebase Cloud Messaging (HTTP v1).

Devices register their token at `POST /auth/device-token`. FCM needs an
OAuth access token made from a service account key; it is made here with
PyJWT (one signed JWT traded at Google's token endpoint), so there is no
Google SDK to install.
"""

import json
import logging
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Annotated, Protocol

import httpx
import jwt
from fastapi import Depends, Request
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker

from {{ name.package }}.core.config import Settings
from {{ name.package }}.modules.users.repository import DeviceTokenRepository

logger = logging.getLogger(__name__)

_FCM_SCOPE = "https://www.googleapis.com/auth/firebase.messaging"

# The access token is asked for again this long before it expires, so no
# send ever goes out with one that expires on the way.
_TOKEN_MARGIN_SECONDS = 300


@dataclass(frozen=True)
class PushNotification:
    """What a device shows, and data for the app."""

    title: str
    body: str
    data: dict[str, str] = field(default_factory=dict)


class PushSender(Protocol):
    """Something that delivers a notification to one device."""

    async def send(self, device_token: str, notification: PushNotification) -> bool:
        """Sends; False when the token is dead (the app was uninstalled) and should be dropped."""
        ...


class LoggingPushSender:
    """Logs pushes instead of sending them, while no service account is set."""

    async def send(self, device_token: str, notification: PushNotification) -> bool:
        """Logs [notification]; every token counts as alive."""
        logger.info("Push (not sent: no FCM key) to %s: %s", device_token[:12], notification.title)
        return True


class FcmPushSender:
    """Sends through FCM with a Firebase service account's key."""

    def __init__(
        self, service_account: dict[str, str], http: httpx.AsyncClient | None = None
    ) -> None:
        self.service_account = service_account
        self.http = http or httpx.AsyncClient(timeout=10)
        self._access_token = ""
        self._expires_at = 0.0

    async def send(self, device_token: str, notification: PushNotification) -> bool:
        """Sends to one device; False for a token FCM no longer knows."""
        project = self.service_account["project_id"]
        response = await self.http.post(
            f"https://fcm.googleapis.com/v1/projects/{project}/messages:send",
            headers={"Authorization": f"Bearer {await self._token()}"},
            json={
                "message": {
                    "token": device_token,
                    "notification": {"title": notification.title, "body": notification.body},
                    "data": notification.data,
                }
            },
        )
        # 404 UNREGISTERED: the app was uninstalled or the token rotated.
        if response.status_code == httpx.codes.NOT_FOUND:
            return False
        response.raise_for_status()
        return True

    async def _token(self) -> str:
        if time.time() < self._expires_at - _TOKEN_MARGIN_SECONDS:
            return self._access_token
        now = int(time.time())
        token_uri = self.service_account["token_uri"]
        assertion = jwt.encode(
            {
                "iss": self.service_account["client_email"],
                "scope": _FCM_SCOPE,
                "aud": token_uri,
                "iat": now,
                "exp": now + 3600,
            },
            self.service_account["private_key"],
            algorithm="RS256",
        )
        response = await self.http.post(
            token_uri,
            data={"grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer", "assertion": assertion},
        )
        response.raise_for_status()
        body = response.json()
        self._access_token = str(body["access_token"])
        self._expires_at = now + float(body["expires_in"])
        return self._access_token


def build_push_sender(settings: Settings) -> PushSender:
    """FCM when `FCM_SERVICE_ACCOUNT_FILE` is set, otherwise a sender that only logs."""
    if not settings.fcm_service_account_file:
        return LoggingPushSender()
    key_file = Path(settings.fcm_service_account_file)
    service_account: dict[str, str] = json.loads(key_file.read_text(encoding="utf-8"))
    return FcmPushSender(service_account)


class PushNotifier:
    """Sends a notification to every device of a user, and drops their dead tokens."""

    def __init__(
        self, sessions: async_sessionmaker[AsyncSession], sender: PushSender
    ) -> None:
        self.sessions = sessions
        self.sender = sender

    async def notify_user(self, user_id: int, notification: PushNotification) -> int:
        """Sends to each of the user's devices; returns how many took it.

        On its own session, so it can run after the caller has committed, and
        a dead token is dropped without touching the caller's unit of work.
        """
        delivered = 0
        async with self.sessions() as session:
            devices = DeviceTokenRepository(session)
            for device in await devices.list_for_user(user_id):
                if await self.sender.send(device.token, notification):
                    delivered += 1
                else:
                    await devices.remove(device.token)
            await session.commit()
        return delivered


def get_push_notifier(request: Request) -> PushNotifier:
    """The app's notifier, for an endpoint (or service) that sends pushes."""
    sender: PushSender = request.app.state.push_sender
    return PushNotifier(request.app.state.session_factory, sender)


PushNotifierDep = Annotated[PushNotifier, Depends(get_push_notifier)]

"""Push notifications: the FCM calls, and dropping tokens FCM no longer knows."""

import json

import httpx
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from fastapi import FastAPI
from httpx import AsyncClient

from {{ name.package }}.modules.users.push import FcmPushSender, PushNotification, PushNotifier

_KEY = rsa.generate_private_key(public_exponent=65537, key_size=2048)
SERVICE_ACCOUNT = {
    "project_id": "demo-project",
    "client_email": "push@demo-project.iam.gserviceaccount.com",
    "token_uri": "https://oauth2.googleapis.com/token",
    "private_key": _KEY.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    ).decode(),
}


def _fcm(status_code: int, seen: list[httpx.Request]) -> httpx.AsyncClient:
    def answer(request: httpx.Request) -> httpx.Response:
        seen.append(request)
        if request.url.host == "oauth2.googleapis.com":
            return httpx.Response(200, json={"access_token": "fcm-access", "expires_in": 3600})
        return httpx.Response(status_code, json={})

    return httpx.AsyncClient(transport=httpx.MockTransport(answer))


async def test_a_push_gets_an_access_token_then_sends_the_message() -> None:
    seen: list[httpx.Request] = []
    sender = FcmPushSender(SERVICE_ACCOUNT, _fcm(200, seen))

    delivered = await sender.send("device-1", PushNotification(title="Hi", body="There"))

    token_request, message_request = seen
    assert delivered
    assert b"jwt-bearer" in token_request.content
    assert message_request.headers["Authorization"] == "Bearer fcm-access"
    assert json.loads(message_request.content)["message"]["token"] == "device-1"


async def test_a_token_fcm_no_longer_knows_is_reported_dead() -> None:
    sender = FcmPushSender(SERVICE_ACCOUNT, _fcm(404, []))

    assert not await sender.send("gone", PushNotification(title="Hi", body="There"))


class _EveryTokenIsDead:
    async def send(self, device_token: str, notification: PushNotification) -> bool:
        return False


async def test_the_notifier_drops_dead_tokens(
    app: FastAPI, client: AsyncClient, signed_in_headers: dict[str, str]
) -> None:
    await client.post("/api/v1/auth/device-token", json={"token": "dead"}, headers=signed_in_headers)
    user_id = int((await client.get("/api/v1/auth/me", headers=signed_in_headers)).json()["id"])
    notifier = PushNotifier(app.state.session_factory, _EveryTokenIsDead())
    notification = PushNotification(title="Hi", body="There")

    first = await notifier.notify_user(user_id, notification)
    second = await notifier.notify_user(user_id, notification)

    assert first == second == 0

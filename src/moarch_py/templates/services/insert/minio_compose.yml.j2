# An S3-compatible bucket: console at http://localhost:9001 (minioadmin / minioadmin).
# Create the bucket there once, then set STORAGE_BACKEND=s3.
minio:
  image: minio/minio:latest
  command: server /data --console-address ":9001"
  environment:
    MINIO_ROOT_USER: minioadmin
    MINIO_ROOT_PASSWORD: minioadmin
  ports:
    - "9000:9000"
    - "9001:9001"

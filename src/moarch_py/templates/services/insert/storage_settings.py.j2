# Where files go: "local" (a folder) or "s3" (any S3-compatible bucket).
storage_backend: str = "local"
storage_local_path: str = "uploads"
s3_bucket: str = "{{ name.distribution }}"
# Empty for AWS itself; MinIO, R2 and others need their URL.
s3_endpoint_url: str = ""
s3_region: str = "us-east-1"
s3_access_key_id: str = ""
s3_secret_access_key: str = ""

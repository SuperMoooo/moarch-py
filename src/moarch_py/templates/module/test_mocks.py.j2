"""The {{ module.url_path }} endpoints with `MOCK_RESPONSES=true`: samples, no database."""

from httpx import AsyncClient

from {{ name.package }}.modules.{{ module.package }}.mocks import SAMPLE_COUNT

URL = "/api/v1/{{ module.url_path }}"


async def test_the_list_serves_the_samples_with_the_mock_header(mock_client: AsyncClient) -> None:
    response = await mock_client.get(URL)

    assert response.status_code == 200
    assert response.headers["X-Mock-Response"] == "true"
    page = response.json()
    assert page["total"] == SAMPLE_COUNT
    assert [item["id"] for item in page["items"]] == list(range(1, SAMPLE_COUNT + 1))


async def test_the_list_pages_through_the_samples(mock_client: AsyncClient) -> None:
    response = await mock_client.get(URL, params={"offset": 1, "limit": 1})

    assert [item["id"] for item in response.json()["items"]] == [2]


async def test_a_sample_is_found_and_any_other_id_is_not(mock_client: AsyncClient) -> None:
    found = await mock_client.get(f"{URL}/1")
    missing = await mock_client.get(f"{URL}/999999")

    assert found.status_code == 200
    assert missing.status_code == 404
    assert missing.json()["error"]["code"] == "not_found"


async def test_writes_answer_as_usual_but_keep_nothing(mock_client: AsyncClient) -> None:
    created = await mock_client.post(URL, json={"name": "New"})
    updated = await mock_client.patch(f"{URL}/1", json={"name": "Changed"})
    deleted = await mock_client.delete(f"{URL}/1")
    after = (await mock_client.get(f"{URL}/1")).json()

    assert created.status_code == 201
    assert created.json()["name"] == "New"
    assert updated.json()["name"] == "Changed"
    assert deleted.status_code == 204
    assert after["name"] != "Changed"
    assert (await mock_client.get(URL)).json()["total"] == SAMPLE_COUNT

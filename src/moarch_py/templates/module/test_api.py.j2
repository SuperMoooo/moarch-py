"""The {{ module.url_path }} endpoints, end to end against the in-memory database."""

from httpx import AsyncClient

URL = "/api/v1/{{ module.url_path }}"


async def test_create_returns_the_new_{{ module.singular_snake }}(client: AsyncClient) -> None:
    response = await client.post(URL, json={"name": "First"})

    assert response.status_code == 201
    body = response.json()
    assert body["name"] == "First"
    assert isinstance(body["id"], int)


async def test_create_rejects_an_empty_name(client: AsyncClient) -> None:
    response = await client.post(URL, json={"name": ""})

    assert response.status_code == 422


async def test_list_pages_through_{{ module.package }}(client: AsyncClient) -> None:
    for name in ("First", "Second", "Third"):
        await client.post(URL, json={"name": name})

    response = await client.get(URL, params={"offset": 1, "limit": 1})

    assert response.status_code == 200
    page = response.json()
    assert page["total"] == 3
    assert [item["name"] for item in page["items"]] == ["Second"]


async def test_update_changes_only_the_fields_sent(client: AsyncClient) -> None:
    created = (await client.post(URL, json={"name": "Before"})).json()

    response = await client.patch(f"{URL}/{created['id']}", json={"name": "After"})

    assert response.status_code == 200
    assert response.json()["name"] == "After"


async def test_delete_then_get_is_not_found(client: AsyncClient) -> None:
    created = (await client.post(URL, json={"name": "Gone soon"})).json()

    deleted = await client.delete(f"{URL}/{created['id']}")
    fetched = await client.get(f"{URL}/{created['id']}")

    assert deleted.status_code == 204
    assert fetched.status_code == 404
    assert fetched.json()["error"]["code"] == "not_found"

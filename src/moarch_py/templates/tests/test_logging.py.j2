"""Log lines: the request ID on every one, and one JSON object per line with LOG_FORMAT=json."""

import json
import logging
import sys

from {{ name.package }}.core.logging import JsonFormatter, RequestContextFilter
from {{ name.package }}.core.request_id import request_id_scope


def _record(message: str, **fields: object) -> logging.LogRecord:
    """A record as `logger.info(message, extra=fields)` would make it, passed through the filter."""
    record = logging.makeLogRecord(
        {"name": "orders", "levelno": logging.INFO, "levelname": "INFO", "msg": message, **fields}
    )
    RequestContextFilter().filter(record)
    return record


def test_a_json_line_has_the_request_id_and_the_extra_fields() -> None:
    with request_id_scope("req-42"):
        record = _record("Order placed", order_id=7)

    line = json.loads(JsonFormatter().format(record))

    assert line["message"] == "Order placed"
    assert line["level"] == "INFO"
    assert line["logger"] == "orders"
    assert line["request_id"] == "req-42"
    assert line["order_id"] == 7


def test_a_line_outside_any_request_says_so() -> None:
    line = json.loads(JsonFormatter().format(_record("Started")))

    assert line["request_id"] == "-"


def test_an_exception_is_one_field_of_the_same_line() -> None:
    try:
        raise ValueError("boom")
    except ValueError:
        record = _record("Failed", exc_info=sys.exc_info())

    line = json.loads(JsonFormatter().format(record))

    assert "ValueError: boom" in line["exception"]

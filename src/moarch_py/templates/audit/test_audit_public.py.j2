"""The audit log, through what other modules use."""

import pytest
from sqlalchemy.ext.asyncio import AsyncSession

from {{ name.package }}.modules.audit.public import list_audit_events, record_audit_event
from {{ name.package }}.modules.audit.repository import AuditEventRepository


async def test_an_entry_is_kept_with_its_unit_of_work(session: AsyncSession) -> None:
    await record_audit_event(
        session,
        action="transfer.approved",
        actor_id=7,
        target_type="transfer",
        target_id="42",
        details={"amount": "10.00"},
    )
    await session.commit()

    (entry,) = await list_audit_events(session, target_type="transfer", target_id="42")

    assert entry.action == "transfer.approved"
    assert entry.actor_id == 7
    assert entry.details == {"amount": "10.00"}


async def test_a_rolled_back_change_leaves_no_entry(session: AsyncSession) -> None:
    await record_audit_event(session, action="transfer.approved", target_type="transfer", target_id="43")
    await session.rollback()

    assert await list_audit_events(session, target_type="transfer", target_id="43") == []


async def test_an_entry_can_never_be_deleted(session: AsyncSession) -> None:
    await record_audit_event(session, action="x.y", target_type="t", target_id="1")
    repository = AuditEventRepository(session)
    (entry,) = await repository.list_for_target("t", "1", limit=1)

    with pytest.raises(TypeError, match="append-only"):
        await repository.delete(entry)

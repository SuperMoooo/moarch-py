"""Database calls for audit_events: add and read, nothing else."""

from collections.abc import Sequence

from sqlalchemy import select

from {{ name.package }}.db.repository import BaseRepository
from {{ name.package }}.modules.audit.models import AuditEvent


class AuditEventRepository(BaseRepository[AuditEvent]):
    """Adds and reads audit entries. Saving changes and deleting are refused."""

    model = AuditEvent

    async def list_for_target(
        self, target_type: str, target_id: str, *, limit: int
    ) -> Sequence[AuditEvent]:
        """The newest entries about one thing first."""
        query = (
            select(AuditEvent)
            .where(AuditEvent.target_type == target_type, AuditEvent.target_id == target_id)
            .order_by(AuditEvent.created_at.desc(), AuditEvent.id.desc())
            .limit(limit)
        )
        return (await self.session.scalars(query)).all()

    async def save(self, entity: AuditEvent) -> AuditEvent:
        """Refused: an audit entry that can change proves nothing."""
        raise TypeError("The audit log is append-only: entries are never changed.")

    async def delete(self, entity: AuditEvent) -> None:
        """Refused: an audit entry that can be deleted proves nothing."""
        raise TypeError("The audit log is append-only: entries are never deleted.")
